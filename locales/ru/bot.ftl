        [few] минуты
       *[many] минут
    } дождь — возьми зонт
}
tip-precip-later = { $kind ->
    [snow] 🌨 Снег ожидается после { $hour } — капюшон сегодня пригодится
   *[rain] ☔ Дождь ожидается после { $hour } — зонт сегодня пригодится
}
