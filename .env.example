# Token from @BotFather
BOT_TOKEN=
# SQLite database (the directory must exist)
DATABASE_URL=sqlite+aiosqlite:///./assistant.db
# HTTPS address of the Mini App (leave empty to hide Mini App buttons)
WEBAPP_URL=
LOG_LEVEL=INFO
# Mini App API (defaults are right for the server)
API_HOST=127.0.0.1
API_PORT=8000
# API docs at /api/docs and /api/openapi.json, for local development (false on the server)
API_DOCS=true
# Build the MIREA group directory in the background (true on the server)
MIREA_DIRECTORY=false
