# Personal Assistant — HTTPS front: the Mini App from webapp/dist, the API on 127.0.0.1:8000.
# Installed by hand to /etc/caddy/Caddyfile (deploy/server-setup.md, section 4). The host name
# comes from SITE_HOST in /etc/caddy/assistant.env, loaded by caddy-assistant.conf.

{$SITE_HOST} {
	encode zstd gzip
	root * /opt/assistant/app/webapp/dist

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "accelerometer=(), autoplay=(), bluetooth=(), camera=(), clipboard-read=(), display-capture=(), fullscreen=(), geolocation=(self), gyroscope=(), hid=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), serial=(), usb=(), web-share=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self' https://web.telegram.org; base-uri 'none'; form-action 'self'"
	}
	# A deletion defers its whole header block to the moment the response is written; kept
	# apart so the block above stays immediate and /api/docs below can replace the CSP.
	header -Server

	# That deferred deletion is skipped when a handler fails (a missing file, the API down):
	# error responses need their own.
	handle_errors {
		header -Server
		respond "{err.status_code} {err.status_text}"
	}

	# Swagger UI loads its script and styles from a CDN and starts with an inline script.
	handle /api/docs* {
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; img-src 'self' data: https://fastapi.tiangolo.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		reverse_proxy 127.0.0.1:8000
	}

	handle /api/* {
		request_body {
			max_size 64KB
		}
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8000
	}

	# File names carry a content hash: a build never changes a file in place.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path is the app itself (hash routing) or a file next to index.html.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
