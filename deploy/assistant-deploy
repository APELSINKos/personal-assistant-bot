#!/usr/bin/env bash
# Deploys one commit of main — bot, API and Mini App — and rolls back automatically if they do
# not come up.
# Called by GitHub Actions through the restricted "deploy" user:
#   sudo /usr/local/sbin/assistant-deploy <40-character commit sha>
# Root may deploy a commit of another branch for a drill: DEPLOY_BRANCH=name (sudo drops this
# variable for the deploy user, so GitHub Actions can only ever deploy main). Root may also
# force a sha that is older than the one currently running: DEPLOY_ALLOW_OLDER=1 (also dropped
# for the deploy user) — without it, an older sha is skipped rather than deployed, so an
# out-of-order CI run (or a leaked deploy key) can never downgrade production. Re-deploying the
# commit that is already running is always allowed.
# The web app is built in a scratch worktree while the running version keeps serving, so a
# build that fails stops nothing; the build it replaces is kept until the new commit is healthy.
# Exit codes: 0 deployed, or skipped because the sha is older than (an ancestor of) the commit
#               already running;
#             1 the deploy failed; the previously running commit is still up (the web app did
#               not build) or up again (rolled back);
#             2 refused — bad argument, invalid branch name, not root, the git fetch of
#               origin/<branch> failed, or the sha is not on origin/<branch>; nothing was
#               stopped;
#             3 another deploy is already running;
#             4 the services are down and the rollback itself failed — manual attention needed.
set -euo pipefail

APP=/opt/assistant/app
WEB=$APP/webapp
BUILD=/opt/assistant/build
NEXT=/opt/assistant/webapp-next
DB=/var/lib/assistant/assistant.db
SNAPSHOTS=/var/backups/assistant
KEEP_SNAPSHOTS=5
BOT=assistant-bot
API=assistant-api
API_HEALTH=http://127.0.0.1:8000/api/health
HEALTH_TIMEOUT=30
branch="${DEPLOY_BRANCH:-main}"
allow_older="${DEPLOY_ALLOW_OLDER:-0}"

sha="${1:-}"
if [[ ! $sha =~ ^[0-9a-f]{40}$ ]]; then
  echo "usage: assistant-deploy <40-character commit sha>" >&2
  exit 2
fi
if [[ ! $branch =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; then
  echo "invalid branch name" >&2
  exit 2
fi
if [[ $EUID -ne 0 ]]; then
  echo "must run as root" >&2
  exit 2
fi

# Caddy (a different user) must be able to read the built web app.
umask 0022

exec 9>/run/assistant-deploy.lock
if ! flock -n 9; then
  echo "another deploy is running" >&2
  exit 3
fi
# Ignore a hangup from the caller's SSH session disconnecting; the redirection below must be
# set up after this so the tee/systemd-cat processes it starts inherit the ignored disposition.
trap '' HUP
# Everything below goes both to the caller (the Actions log) and to the journal. "tee -p"
# keeps writing to the journal even after the reader on the other end (the caller's SSH
# session) goes away, instead of dying of SIGPIPE and taking the rest of the script with it.
exec > >(tee -p >(systemd-cat -t assistant-deploy)) 2>&1

as_app() {
  runuser -u assistant -- env -i HOME=/opt/assistant PATH=/usr/local/bin:/usr/bin:/bin \
    UV_CACHE_DIR=/opt/assistant/.cache/uv UV_PYTHON_DOWNLOADS=never UV_COMPILE_BYTECODE=1 "$@"
}

with_service_env() {
  as_app bash -c 'set -a; . /etc/assistant/assistant.env; set +a; exec "$@"' _ "$@"
}

# Whether commit $1 has the API / the web app (commits before v2.1.0 have neither).
has_api() {
  as_app git cat-file -e "$1:src/assistant/api/__main__.py" 2>/dev/null
}

has_webapp() {
  as_app git cat-file -e "$1:webapp/package-lock.json" 2>/dev/null
}

built=0
build() {
  built=1
  as_app git checkout --quiet --detach "$1" &&
    as_app uv sync --frozen --no-dev --quiet
}

drop_worktree() {
  as_app git worktree remove --force "$BUILD" >/dev/null 2>&1 || true
  as_app rm -rf "$BUILD"
  as_app git worktree prune
}

# Builds the web app of commit $1 into $NEXT without touching the running version.
build_webapp() {
  local status=0
  drop_worktree
  # Single quotes on purpose: $1 is the inner bash's argument.
  as_app git worktree add --quiet --detach "$BUILD" "$1" &&
    as_app bash -c 'cd "$1/webapp" && export NPM_CONFIG_UPDATE_NOTIFIER=false &&
      npm ci --no-audit --no-fund --ignore-scripts --loglevel=error &&
      NODE_OPTIONS=--max-old-space-size=512 npm run build' _ "$BUILD" &&
    as_app rm -rf "$NEXT" &&
    as_app mv "$BUILD/webapp/dist" "$NEXT" || status=1
  drop_worktree
  return "$status"
}

web=0
swapped=0
# Puts the new build in place, keeping the one it replaces for a rollback. Also runs when the
# new commit has no web app of its own (web=0): an existing dist is moved aside rather than
# left live with no API behind it, with the same bookkeeping so a rollback puts it back.
# swapped is set only once the old build is safely aside, so a failure before that point
# leaves dist untouched and the rollback below knows not to touch it either.
swap_webapp() {
  [[ $web -eq 1 || -d $WEB/dist ]] || return 0
  as_app rm -rf "$WEB/dist.previous" || return 1
  if [[ -d $WEB/dist ]]; then
    as_app mv "$WEB/dist" "$WEB/dist.previous" || return 1
  fi
  swapped=1
  [[ $web -eq 1 ]] || return 0
  as_app mv "$NEXT" "$WEB/dist"
}

# Puts back the web app that was live before swap_webapp (none, if there was none).
restore_webapp() {
  as_app rm -rf "$WEB/dist" &&
    { [[ ! -d $WEB/dist.previous ]] || as_app mv "$WEB/dist.previous" "$WEB/dist"; }
}

# The API is up and reports commit $1. The whole answer is read (no grep -q): with pipefail,
# an early exit of grep could fail curl with SIGPIPE and turn a match into a failure.
api_answers() {
  curl -fsS --max-time 2 "$API_HEALTH" 2>/dev/null | grep -F "\"commit\":\"$1\"" >/dev/null
}

services_up() {  # $1 = 1 when the API has to be up as well
  systemctl is-active --quiet "$BOT" && { [[ $1 -eq 0 ]] || systemctl is-active --quiet "$API"; }
}

healthy() {  # $1 = the bot's invocation id, $2 = the expected commit, $3 = 1 when the API runs
  local inv=$1 commit=$2 api=$3
  for _ in $(seq "$HEALTH_TIMEOUT"); do
    sleep 1
    if services_up "$api" &&
      journalctl _SYSTEMD_INVOCATION_ID="$inv" -o cat | grep "Bot started" >/dev/null &&
      { [[ $api -eq 0 ]] || api_answers "$commit"; }; then
      sleep 3
      services_up "$api" && return 0
    fi
  done
  return 1
}

start_and_check() {  # $1 = the commit that is checked out
  local api=0 api_ok=1
  if has_api "$1"; then
    api=1
    systemctl start "$API" || api_ok=0
  fi
  # The bot is started regardless of whether the API came up, so it keeps serving reminders
  # even if the API failed to start; healthy() below still fails the deploy in that case.
  systemctl start "$BOT" || return 1
  healthy "$(systemctl show -p InvocationID --value "$BOT")" "$1" "$api" && [[ $api_ok -eq 1 ]]
}

# Keeps the newest $KEEP_SNAPSHOTS pre-deploy snapshots (by modification time). Runs as the
# app user, like everything else that touches its files, and is NUL-safe for any file name.
prune_snapshots() {
  # Single quotes on purpose: $1 and $2 are the inner bash's arguments.
  as_app bash -c 'find "$1" -maxdepth 1 -name "pre-deploy-*.db" -printf "%T@ %p\0" |
    sort -zrn | tail -zn +"$(($2 + 1))" | cut -zd" " -f2- | xargs -0r rm --' \
    _ "$SNAPSHOTS" "$KEEP_SNAPSHOTS"
}

snapshot=""
take_snapshot() {
  [[ -f $DB ]] || return 0
  snapshot="$SNAPSHOTS/pre-deploy-${sha:0:12}.db"
  as_app sqlite3 "$DB" ".backup '$snapshot'" &&
    prune_snapshots
}

restore_snapshot() {
  as_app cp "$snapshot" "$DB.restore" &&
    mv -f "$DB.restore" "$DB" &&
    rm -f "$DB-wal" "$DB-shm"
}

# Nothing changed (or the change was undone) — try to leave the previously running commit up
# and healthy; used both when a pre-stop step fails and when the snapshot itself fails. A
# successful build_webapp before either of those points can leave $NEXT behind unswapped.
give_up_unchanged() {
  as_app rm -rf "$NEXT" || echo "warning: could not remove $NEXT" >&2
  if start_and_check "$previous"; then
    echo "$previous is running"
    exit 1
  fi
  echo "ROLLBACK FAILED: the services are down, manual attention needed" >&2
  exit 4
}

cd "$APP" || {
  echo "refusing: cannot cd to $APP" >&2
  exit 2
}
if ! as_app git fetch --quiet origin "$branch"; then
  echo "refusing: git fetch of origin/$branch failed" >&2
  exit 2
fi
if ! as_app git merge-base --is-ancestor "$sha" "origin/$branch"; then
  echo "refusing: $sha is not on origin/$branch" >&2
  exit 2
fi
previous=$(as_app git rev-parse HEAD) || {
  echo "refusing: cannot determine the currently running commit" >&2
  exit 2
}

if [[ $sha != "$previous" && $allow_older != 1 ]] &&
  as_app git merge-base --is-ancestor "$sha" "$previous"; then
  echo "skipping: $sha is older than (an ancestor of) the running $previous"
  exit 0
fi
echo "deploying $sha (running $previous)"

if has_webapp "$sha"; then
  web=1
  echo "building the web app"
  if ! build_webapp "$sha"; then
    echo "deploy of $sha failed: the web app did not build; $previous is still running" >&2
    exit 1
  fi
fi

if ! systemctl stop "$BOT" "$API"; then
  echo "deploy of $sha failed: could not stop the services" >&2
  echo "see: journalctl -u $BOT -u $API -n 50" >&2
  give_up_unchanged
fi

if take_snapshot && build "$sha" && swap_webapp &&
  with_service_env .venv/bin/alembic upgrade head && start_and_check "$sha"; then
  as_app rm -rf "$WEB/dist.previous" || echo "warning: could not remove $WEB/dist.previous" >&2
  echo "deployed $sha"
  exit 0
fi

# A successful build_webapp can leave $NEXT behind unswapped if a later step failed first.
as_app rm -rf "$NEXT" || echo "warning: could not remove $NEXT" >&2

echo "deploy of $sha failed" >&2
echo "see: journalctl -u $BOT -u $API -n 50" >&2

if [[ $built -eq 0 ]]; then
  # The snapshot step itself failed before anything changed — just bring the still-current
  # version back up, no checkout/rebuild and nothing to restore.
  give_up_unchanged
fi

echo "rolling back to $previous" >&2
systemctl stop "$BOT" "$API" || true
if [[ -n $snapshot ]] && ! restore_snapshot; then
  echo "ROLLBACK FAILED: could not restore the database, the services are down, manual attention needed" >&2
  exit 4
fi
if [[ $swapped -eq 1 ]] && ! restore_webapp; then
  echo "warning: could not put the previous web app back" >&2
fi
if build "$previous" && start_and_check "$previous"; then
  echo "rolled back to $previous"
  exit 1
fi
echo "ROLLBACK FAILED: the services are down, manual attention needed" >&2
exit 4
